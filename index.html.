<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#070b18">
<title>ZAPSHOT FPS</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@800;900&family=Rajdhani:wght@500;600;700&display=swap">
<style>
:root{--bg:#070b18;--panel:rgba(10,16,36,.86);--ink:#eaf2ff;--dim:#8ea0c4;--zap:#ffe14d;--cy:#35e0ff;--mag:#ff3d81;--ok:#6dff9b;--line:rgba(120,160,255,.22);
--disp:'Orbitron','Rajdhani',system-ui,sans-serif;--ui:'Rajdhani','Segoe UI',system-ui,-apple-system,sans-serif;
--sl:env(safe-area-inset-left,0px);--sr:env(safe-area-inset-right,0px);--st:env(safe-area-inset-top,0px);--sb:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none}
html,body{margin:0;height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font-family:var(--ui);font-weight:600;
user-select:none;-webkit-user-select:none;touch-action:none;overscroll-behavior:none;position:fixed;inset:0;width:100%}
#gl{position:fixed;inset:0;width:100%;height:100%;display:block;background:#0a0e1c}
.hide{display:none!important}
button,input{font:inherit;color:inherit}

/* ---------------- screens ---------------- */
#screens{position:fixed;inset:0;pointer-events:none;z-index:50}
.screen{position:absolute;inset:0;display:none;align-items:center;justify-content:center;pointer-events:auto;
padding:max(10px,var(--st)) max(14px,var(--sr)) max(10px,var(--sb)) max(14px,var(--sl));
background:radial-gradient(ellipse at 50% 40%,rgba(7,11,24,.35),rgba(7,11,24,.85))}
.screen.on{display:flex}
#s-main{flex-direction:row;gap:6vw;background:linear-gradient(100deg,rgba(7,11,24,.9) 5%,rgba(7,11,24,.45) 60%,rgba(7,11,24,.1))}
#s-edit,#s-load{background:none}
#s-edit{align-items:flex-start;pointer-events:none}
#s-edit .editbar,#s-edit .edhint{pointer-events:auto}
#s-load{background:rgba(7,11,24,.9)}
.logo{text-align:left}
.logo h1{margin:0;font-family:var(--disp);font-weight:900;font-size:clamp(34px,9vw,84px);letter-spacing:.02em;line-height:1;text-shadow:0 0 28px rgba(255,225,77,.35)}
.logo h1 em{font-style:normal;color:var(--zap)}
.logo small{display:block;margin-top:6px;letter-spacing:.42em;color:var(--cy);font-size:clamp(10px,1.6vw,15px)}
.bolt{display:block;width:clamp(28px,5vw,52px);height:clamp(40px,7vw,74px);background:linear-gradient(160deg,#fff7b0,var(--zap) 50%,#ff9d00);clip-path:polygon(58% 0,6% 56%,44% 56%,30% 100%,94% 40%,56% 40%);margin-bottom:6px;filter:drop-shadow(0 0 12px rgba(255,225,77,.7))}
.menu{display:flex;flex-direction:column;gap:10px;min-width:min(78vw,300px)}
.menu .row{display:flex;gap:8px}.menu .row .btn{flex:1;padding:10px 6px;font-size:clamp(12px,2.2vw,15px)}
.btn{position:relative;border:1px solid var(--line);background:rgba(20,30,64,.8);padding:12px 18px;font-weight:700;letter-spacing:.12em;font-size:clamp(13px,2.4vw,16px);
cursor:pointer;transform:skewX(-8deg);transition:background .12s,transform .08s,border-color .12s;min-height:44px}
.btn>*{display:inline-block;transform:skewX(8deg)}
.btn:hover{background:rgba(40,60,120,.85);border-color:var(--cy)}
.btn:active{transform:skewX(-8deg) scale(.97)}
.btn.big{background:linear-gradient(90deg,#ffd400,#ff9d00);color:#16120a;border-color:transparent;font-size:clamp(15px,2.8vw,20px);font-weight:700}
.btn.big:hover{filter:brightness(1.1)}
.btn.alt{background:linear-gradient(90deg,#16d4ff,#3b7bff);color:#06101e}
.btn.ghost{background:transparent}.btn.sm{padding:6px 12px;min-height:34px;font-size:13px}
.btn:disabled{opacity:.4;pointer-events:none}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:16px 20px;max-height:100%;max-width:100%;width:min(92vw,460px);backdrop-filter:blur(6px);box-shadow:0 10px 40px rgba(0,0,0,.5)}
.panel.wide{width:min(96vw,860px)}
.panel.scroll,.scroll{overflow-y:auto;touch-action:pan-y;-webkit-overflow-scrolling:touch}
.panel h2{margin:0 0 10px;font-family:var(--disp);font-weight:800;font-size:clamp(16px,3vw,24px);letter-spacing:.1em;color:var(--zap)}
.lbl{font-size:12px;letter-spacing:.22em;color:var(--dim);margin:8px 0 6px}.lbl.sm{margin-top:10px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.box{border:1px solid var(--line);padding:10px 12px;background:rgba(255,255,255,.03);border-radius:3px;min-width:0}
.actions{display:flex;gap:10px;justify-content:flex-end;margin-top:14px;flex-wrap:wrap}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{flex:1;min-width:0;white-space:nowrap;border:1px solid var(--line);background:rgba(20,30,64,.7);padding:8px 10px;font-weight:700;letter-spacing:.08em;cursor:pointer;min-height:40px}
.seg button.on{background:var(--zap);color:#141008;border-color:var(--zap)}
.maps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.map{border:2px solid var(--line);cursor:pointer;padding:0;background:none;text-align:left;overflow:hidden;border-radius:3px;min-width:0}
.map .pic{height:clamp(44px,12vh,90px)}
.map b{display:block;padding:6px 8px 0;font-size:clamp(11px,2vw,14px);letter-spacing:.08em}
.map small{display:block;padding:0 8px 8px;color:var(--dim);font-size:11px;font-weight:500;line-height:1.2}
.map.on{border-color:var(--zap);box-shadow:0 0 18px rgba(255,225,77,.25)}
input[type=text],input:not([type]),input.code{width:100%;background:rgba(0,0,20,.5);border:1px solid var(--line);padding:10px 12px;font-size:16px;letter-spacing:.06em;min-height:44px;user-select:text;-webkit-user-select:text;touch-action:manipulation}
input.code{text-transform:uppercase;text-align:center;font-family:var(--disp);font-size:22px;letter-spacing:.3em;margin-bottom:8px}
input:focus{outline:2px solid var(--cy)}
.status{margin:8px 0;padding:6px 10px;border-left:3px solid var(--dim);font-size:14px;color:var(--dim)}
.status.ok{border-color:var(--ok);color:var(--ok)}.status.bad{border-color:var(--mag);color:var(--mag)}
.hint{color:var(--dim);font-size:13px;font-weight:500;margin:8px 0 0}
.codebig{font-family:var(--disp);letter-spacing:.3em;color:#fff}
.plist{list-style:none;margin:0;padding:0}.plist li{padding:7px 4px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:8px}
.plist li i{font-style:normal;color:var(--zap);font-size:12px;letter-spacing:.15em}
.info{font-size:15px;line-height:1.5}
.kv{list-style:none;margin:0;padding:0;font-size:14px;line-height:1.5;font-weight:500}.kv li{padding:3px 0}.kv b{color:var(--cy);font-weight:700}
.cred{color:var(--dim);font-weight:500;line-height:1.5}
.setgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:4px 22px}
.srow{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid rgba(120,160,255,.1);min-height:44px}
.srow>span{font-size:14px;letter-spacing:.06em;flex:0 0 38%}
.srow input[type=range]{flex:1;min-width:0;accent-color:var(--zap);touch-action:pan-x;height:30px}
.srow output{width:42px;text-align:right;color:var(--zap);font-size:14px}
.srow .seg{flex:1}.srow .seg button{min-height:34px;padding:4px 6px;font-size:13px}
table{width:100%;border-collapse:collapse}
th{font-size:11px;letter-spacing:.2em;color:var(--dim);text-align:left;padding:4px 6px}
td{padding:5px 6px;border-top:1px solid rgba(120,160,255,.12);font-size:15px}
td:nth-child(n+3),th:nth-child(n+3){text-align:right}
tr.me td{color:var(--zap);font-weight:700;background:rgba(255,225,77,.07)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin-bottom:10px}
.stat{border:1px solid var(--line);padding:8px;text-align:center;background:rgba(255,255,255,.03)}
.stat b{display:block;font-family:var(--disp);font-size:clamp(18px,3.4vw,26px);color:#fff}.stat span{font-size:11px;letter-spacing:.2em;color:var(--dim)}
.editbar{display:flex;gap:12px;align-items:center;background:var(--panel);border:1px solid var(--line);padding:6px 12px;margin:0 auto;flex-wrap:wrap;justify-content:center}
.editbar label{display:flex;align-items:center;gap:8px;font-size:13px;letter-spacing:.1em}.editbar input{accent-color:var(--zap);width:150px;min-height:30px;touch-action:pan-x}
.edhint{position:absolute;left:0;right:0;bottom:calc(14px + var(--sb));text-align:center;color:var(--dim);font-size:13px}

/* ---------------- HUD ---------------- */
#hud{position:fixed;inset:0;pointer-events:none;z-index:10;font-family:var(--ui)}
#hud>*{position:absolute}
#vig{inset:0;background:radial-gradient(ellipse at center,transparent 45%,rgba(255,0,40,.75));opacity:0;transition:opacity .2s}
#dmg{inset:0}
#dmg i{position:absolute;inset:0;opacity:0;background:linear-gradient(180deg,rgba(255,40,60,.85),transparent 22%);will-change:opacity,transform}
#scope{inset:0;display:none;background:radial-gradient(circle at center,transparent 0,transparent 28vh,#000 28.3vh)}
#scope i,#scope b{position:absolute;background:rgba(0,0,0,.85)}
#scope i{left:0;right:0;top:calc(50% - 1px);height:2px}#scope b{top:0;bottom:0;left:calc(50% - 1px);width:2px}
#xh{left:50%;top:50%;width:0;height:0;--g:8px}
#xh i{position:absolute;background:#fff;box-shadow:0 0 3px #000;width:2px;height:9px}
#xh .t{left:-1px;top:calc(var(--g)*-1 - 9px)}#xh .b{left:-1px;top:var(--g)}
#xh .l,#xh .r{width:9px;height:2px}#xh .l{top:-1px;left:calc(var(--g)*-1 - 9px)}#xh .r{top:-1px;left:var(--g)}
#xh u{position:absolute;left:-1.5px;top:-1.5px;width:3px;height:3px;background:var(--zap);border-radius:50%;box-shadow:0 0 3px #000}
#xh.hidden{display:none}
#hm{left:50%;top:50%;width:0;height:0;opacity:0;transition:opacity .25s}
#hm i{position:absolute;width:3px;height:11px;background:#fff;left:-1.5px;top:-5.5px;transform-origin:50% 50%}
#hm i:nth-child(1){transform:rotate(45deg) translateY(-14px)}#hm i:nth-child(2){transform:rotate(-45deg) translateY(-14px)}
#hm i:nth-child(3){transform:rotate(135deg) translateY(-14px)}#hm i:nth-child(4){transform:rotate(-135deg) translateY(-14px)}
#hm.kill i{background:var(--mag)}#hm.head i{background:var(--zap)}#hm.on{opacity:1;transition:none}
#topL{left:max(12px,var(--sl));top:max(8px,var(--st));display:flex;gap:6px}
.chip{background:rgba(5,10,28,.6);border-left:3px solid var(--zap);padding:3px 10px;min-width:56px}
.chip span{display:block;font-size:10px;letter-spacing:.2em;color:var(--dim)}.chip b{font-family:var(--disp);font-size:16px}
.chip.rank{border-color:var(--cy)}
#timer{left:50%;top:max(6px,var(--st));transform:translateX(-50%);font-family:var(--disp);font-weight:800;font-size:clamp(18px,3.4vw,26px);background:rgba(5,10,28,.6);padding:2px 16px;letter-spacing:.08em;border-bottom:2px solid var(--zap)}
#timer.low{color:var(--mag);border-color:var(--mag)}
#ping{right:max(12px,var(--sr));bottom:max(4px,var(--sb));font-size:11px;color:var(--dim)}
#feed{right:max(12px,var(--sr));top:calc(max(8px,var(--st)) + 4px);width:min(42vw,300px);display:flex;flex-direction:column;align-items:flex-end;gap:3px}
#feed div{background:rgba(5,10,28,.65);padding:2px 9px;font-size:14px;border-right:3px solid var(--cy);animation:fadeo 5s forwards;white-space:nowrap}
#feed div.me{border-color:var(--zap)}#feed div.die{border-color:var(--mag)}
#feed b{color:var(--zap)}
@keyframes fadeo{0%,80%{opacity:1}100%{opacity:0}}
#bot{left:50%;bottom:max(8px,var(--sb));transform:translateX(-50%);display:flex;gap:14px;align-items:flex-end}
#vitals{display:flex;flex-direction:column;gap:3px;align-items:stretch;width:min(24vw,190px)}
#sh{position:relative;height:12px;background:rgba(5,10,28,.65);border:1px solid var(--line);overflow:hidden}
#shf{height:100%;width:0;background:linear-gradient(90deg,#2d8bff,#74d6ff);transition:width .15s}
#sht{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-size:9px;text-shadow:0 0 3px #000}
#cons{display:flex;gap:6px;font-size:11px;letter-spacing:.06em;min-height:14px;color:var(--dim)}#cons span{background:rgba(5,10,28,.6);padding:0 5px;border-bottom:2px solid var(--c)}
#hp{position:relative;width:100%;height:22px;background:rgba(5,10,28,.65);border:1px solid var(--line);overflow:hidden}
#hpf{height:100%;width:100%;background:linear-gradient(90deg,#26d46b,#8cff6b);transition:width .15s}
#hpf.low{background:linear-gradient(90deg,#ff2d55,#ff7a3d)}
#hpt{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-size:13px;text-shadow:0 0 3px #000}
#ammoBox{background:rgba(5,10,28,.65);padding:2px 12px;border-right:3px solid var(--zap);min-width:120px;text-align:right}
#wname{font-size:11px;letter-spacing:.2em;color:var(--cy)}
#ammo b{font-family:var(--disp);font-size:clamp(20px,3.6vw,30px)}#ammo span{color:var(--dim);font-size:14px;margin-left:4px}
#ammo.low b{color:var(--mag)}
#status{font-size:11px;letter-spacing:.2em;color:var(--zap);height:13px}
#wslots{left:max(12px,var(--sl));top:calc(max(8px,var(--st)) + 54px + min(26vh,118px) + 8px);display:flex;flex-direction:column;gap:4px}
#wslots div{background:rgba(5,10,28,.55);padding:2px 8px;font-size:12px;letter-spacing:.12em;border-left:3px solid transparent;color:var(--dim)}
#wslots div.on{border-color:var(--zap);color:#fff;background:rgba(255,225,77,.15)}
#toast{left:50%;top:22%;transform:translateX(-50%);font-family:var(--disp);font-size:clamp(14px,2.8vw,22px);color:var(--zap);text-shadow:0 0 10px #000;opacity:0;transition:opacity .3s;white-space:nowrap}
#toast.on{opacity:1}
#center{left:0;right:0;top:36%;text-align:center;font-family:var(--disp);font-weight:900;font-size:clamp(30px,8vw,76px);text-shadow:0 0 20px rgba(0,0,0,.8);color:#fff}
#center small{display:block;font-family:var(--ui);font-size:clamp(13px,2.4vw,20px);letter-spacing:.2em;color:var(--dim)}
#board{left:50%;top:50%;transform:translate(-50%,-50%);width:min(92vw,520px);background:var(--panel);border:1px solid var(--line);padding:10px 14px;display:none;max-height:86vh;overflow:hidden}
#board h3{margin:0 0 6px;font-family:var(--disp);font-size:14px;letter-spacing:.2em;color:var(--zap)}
#board.on{display:block}

/* ---------------- touch controls ---------------- */
#touch{position:fixed;inset:0;z-index:20;display:none;pointer-events:none;--op:.6;padding:0 var(--sr) 0 var(--sl)}
#touch.show,#touch.edit{display:block}
#lookZone,#joyZone{position:absolute;top:0;bottom:0;pointer-events:auto;touch-action:none}
#lookZone{left:40%;right:0}#joyZone{left:0;width:45%}
#joyHint{position:absolute;left:18%;top:68%;width:110px;height:110px;margin:-55px;border:2px dashed rgba(255,255,255,.22);border-radius:50%;opacity:.8}
#joyBase{position:absolute;border-radius:50%;border:2px solid rgba(255,255,255,.45);background:rgba(255,255,255,.08);transform:translate(-50%,-50%);opacity:0;pointer-events:none;width:116px;height:116px}
#joyKnob{position:absolute;left:50%;top:50%;width:46%;height:46%;margin:-23% 0 0 -23%;border-radius:50%;background:rgba(255,255,255,.55);box-shadow:0 0 12px rgba(0,0,0,.4)}
.tb{position:absolute;transform:translate(-50%,-50%);border-radius:50%;border:2px solid rgba(255,255,255,.65);background:rgba(20,30,60,.55);opacity:var(--op);
color:#fff;font-weight:700;letter-spacing:.06em;pointer-events:auto;touch-action:none;padding:0;display:flex;align-items:center;justify-content:center;text-shadow:0 1px 3px #000;line-height:1}
.tb.shoot{background:rgba(255,60,90,.5);border-color:#ff8aa0}
.tb.small{border-radius:10px}
.tb.down{background:rgba(255,225,77,.75);color:#111;transform:translate(-50%,-50%) scale(.93);opacity:1}
.tb.on{background:rgba(53,224,255,.65);color:#041018;opacity:1}
#touch.edit .tb{outline:2px dashed rgba(255,255,255,.5);opacity:.9}#touch.edit .tb.sel{outline:3px solid var(--zap)}
#touch.edit #lookZone,#touch.edit #joyZone{pointer-events:none}

#rotate{position:fixed;inset:0;z-index:200;background:#070b18;display:none;align-items:center;justify-content:center;text-align:center;padding:20px}
#rotate .rot{width:64px;height:100px;border:4px solid var(--zap);border-radius:10px;margin:0 auto 18px;animation:rot 2.2s ease-in-out infinite}
@keyframes rot{0%,30%{transform:rotate(0)}60%,100%{transform:rotate(-90deg)}}
@media (orientation:portrait) and (pointer:coarse){#rotate{display:flex}}
#err{position:fixed;left:8px;right:8px;bottom:8px;z-index:300;background:rgba(120,0,20,.92);padding:8px 12px;font-size:13px;display:none;max-height:40vh;overflow:auto;user-select:text;-webkit-user-select:text;touch-action:pan-y}
@media (max-height:480px){
 .panel{padding:10px 14px}.panel h2{margin-bottom:4px}.btn{padding:8px 14px;min-height:38px}.menu{gap:7px}
 .lbl{margin:4px 0 4px}.seg button{min-height:34px;padding:5px 8px}.maps .pic{height:36px}.map small{display:none}
 #s-main{gap:4vw}.setgrid{grid-template-columns:1fr 1fr}.actions{margin-top:8px}
}
@media (max-width:640px) and (orientation:landscape){#s-main .logo small{display:none}.setgrid{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){#rotate .rot{animation:none}}

/* ---------------- heroes / ability / minimap ---------------- */
#mm{left:max(12px,var(--sl));top:calc(max(8px,var(--st)) + 50px);width:min(26vh,118px);height:min(26vh,118px);border-radius:50%;border:2px solid var(--line);background:rgba(5,10,28,.55);box-shadow:0 0 12px rgba(0,0,0,.5)}
#abHud{left:max(12px,var(--sl));bottom:max(8px,var(--sb));display:flex;align-items:center;gap:8px;background:rgba(5,10,28,.65);padding:4px 8px;border-left:3px solid var(--ab,#ffd400);min-width:150px;position:absolute}
.abIcon{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;background:rgba(255,255,255,.1);border:2px solid var(--ab,#ffd400);color:var(--ab,#ffd400);flex:none}
.abTxt{display:flex;flex-direction:column;flex:1;min-width:0;position:relative}.abTxt b{font-size:12px;letter-spacing:.14em;white-space:nowrap}.abTxt span{font-size:11px;letter-spacing:.16em;color:var(--dim)}
.abTxt i{display:block;height:3px;background:var(--ab,#ffd400);width:100%;transform-origin:left;margin-top:2px}
#abHud kbd{font-family:var(--disp);font-size:11px;border:1px solid var(--line);padding:1px 6px;color:var(--dim)}
#abHud.ready .abIcon{box-shadow:0 0 14px var(--ab,#ffd400);animation:pulse 1.4s ease-in-out infinite}
#abHud.ready span{color:var(--ok)}
@keyframes pulse{50%{transform:scale(1.08)}}
.tb.ability{--ab:#ffd400;border-color:var(--ab);flex-direction:column;gap:1px;background:rgba(20,30,60,.7)}
.tb.ability span{font-size:1.9em;line-height:1;color:var(--ab)}.tb.ability small{font-size:.75em;min-height:1em}
.tb.ability.cool{opacity:.55;border-color:rgba(255,255,255,.35)}.tb.ability.cool span{color:#9aa}
.tb.ability.rdy{box-shadow:0 0 18px var(--ab);opacity:1}
.heroBtn{border-color:var(--cy)}.heroBtn b{color:var(--zap)}
.heroChip{display:flex;align-items:center;gap:10px;margin-bottom:6px;flex-wrap:wrap}.heroChip .lbl{margin:0}.heroChip b{font-family:var(--disp);color:var(--zap);letter-spacing:.1em}.heroChip i{font-style:normal;color:var(--dim);font-size:13px;flex:1;min-width:80px}
#s-char{background:linear-gradient(90deg,rgba(7,11,24,.88),rgba(7,11,24,.2) 45%,rgba(7,11,24,.88));padding:0}
