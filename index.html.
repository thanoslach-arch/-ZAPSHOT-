      feedKill(k && k !== v ? k : null, v, WEAPONS[m.w] ? WEAPONS[m.w].short : "", !!m.head);
      if (v.ch) {
        v.ch.die();
        if (fx) fx.impact(v.x, v.y + 1, v.z, 0, 1, 0, 2, 14);
        play("death", v);
      }
      if (k === me) {
        me.hs += m.head ? 1 : 0;
        hud.hit("kill");
        play("kill");
        hud.toast("ELIMINATED " + v.name.toUpperCase(), 1200);
        const lw = WEAPONS[m.w];
        if (lw) addAmmo(me, lw.ammo, Math.ceil(lw.mag * 0.5));
      }
      if (v === me) {
        play("death");
        deathT = 0;
        setAdsButton(false);
        inp.fire = false;
        hud.center("ELIMINATED" + (k && k !== me ? `<small>BY ${esc(k.name.toUpperCase())}</small>` : ""));
      }
    });
    on("spawn", (m) => {
      if (mode !== "mp") return;
      const c = byId(m.id);
      if (!c) return;
      if (c === me) {
        placeAt(me, pickSpawn(me));
        resetAbil(me, 6);
        me.alive = true;
        refill(me);
        me.invuln = 2;
        hud.center("");
        play("spawn");
        me.switchT = 0;
        pendWi = -1;
        setVM();
        me.snapPos = true;
      } else {
        c.alive = true;
        resetAbil(c, 6);
        if (c.ch) c.ch.revive();
        c.snapped = false;
      }
    });
    on("ab", (m) => {
      if (mode !== "mp") return;
      const c = byId(m.id);
      if (!c) return;
      const sv = { x: c.x, y: c.y, z: c.z };
      if (c !== me) {
        c.x = m.x;
        c.y = m.y;
        c.z = m.z;
      }
      activate(c, abX, m);
      if (c !== me) {
        c.x = sv.x;
        c.y = sv.y;
        c.z = sv.z;
      }
    });
    on("abno", (m) => {
      if (mode === "mp" && me) {
        hud.toast(m.why, 1e3);
        play("ab_deny");
      }
    });
    on("left", (m) => {
      const c = byId(m.id);
      if (c) {
        hud.feed(`${esc(c.name)} left the match`);
        removeC(c);
      }
    });
    on("end", (m) => {
      if (mode !== "mp") return;
      applyScores(m.scores);
      for (const s of m.scores) {
        const c = byId(s.id);
        if (c) {
          c.kills = s.k;
          c.deaths = s.d;
          c.score = s.s;
        }
      }
      timeLeft = 0;
      endMatch();
    });
  }
  function gameLobby(m) {
    if (mode !== "mp") return;
    const ids = new Set(m.players.map((p) => p.id));
    for (const p of m.players) if (p.id !== net.id) addRemote(p);
    for (const c of list.slice()) if (c.kind === "remote" && !ids.has(c.id)) removeC(c);
  }
  function toLobbyView(map) {
    cleanup();
    mode = "menu";
    phase = "menu";
    uiOpen = false;
    hud.show(false);
    syncTouch();
    stopMusic();
    if (document.exitPointerLock) document.exitPointerLock();
    loadMap(map || S.mpMap, false);
    startMusic("menu");
  }
  var refreshTouch = () => syncTouch();
  function removeC(c) {
    if (c.ch) {
      c.ch.dispose();
      c.ch = null;
    }
    const i = list.indexOf(c);
    if (i >= 0) list.splice(i, 1);
  }
  var errShown = false;
  function frame(dtReal) {
    try {
      const dt = Math.min(dtReal, 0.05);
      if (phase === "menu") {
        menuAng += dt * 0.12;
        if (previewOn && preview) preview.update(dt);
        const r = mapDef.half * 0.72;
        camera.position.set(Math.cos(menuAng) * r, 14, Math.sin(menuAng) * r);
        camera.rotation.set(-0.38, -menuAng + Math.PI / 2, 0);
        if (camFov !== 70) {
          camFov = 70;
          camera.fov = 70;
          camera.updateProjectionMatrix();
        }
        sun.position.set(sunOff[0], sunOff[1], sunOff[2]);
        sun.target.position.set(0, 0, 0);
        vmRoot.visible = false;
      } else if (phase === "paused" || phase === "over") {
        if (fx) fx.update(dt);
      } else update(dt);
      if (phase === "over" || phase === "paused") {
        for (const c of list) if (c.ch) c.ch.update(dt, 0, 99);
      }
      if (mapGroup && mapGroup.userData.clouds) mapGroup.userData.clouds.rotation.y += dt * 4e-3;
      if (mapGroup && mapGroup.userData.tick) mapGroup.userData.tick(dt, camera.position);
      render();
    } catch (e) {
      if (!errShown) {
        errShown = true;
        const el2 = document.getElementById("err");
        el2.style.display = "block";
        el2.textContent = "Error: " + (e && e.message) + "\n" + (e && e.stack ? e.stack.split("\n").slice(0, 3).join("\n") : "");
      }
      console.error(e);
    }
  }
  function debugJump() {
    deployPress = true;
  }
  function debugLand() {
    clearAir();
    for (const c of list) {
      placeAt(c, pickSpawn(c));
      c.air = null;
      c.invuln = 0;
      if (c.ch) c.ch.root.visible = true;
    }
    document.body.classList.remove("air");
  }
  function debugSetGm(g) {
    S.gmode = g;
  }
  function debugKill(id) {
    const c = list.find((x) => x.id === id);
    if (c) {
      c.invuln = 0;
      applyDamage(c, 9999, c, "TEST", false);
    }
  }
  function debugState() {
    return { gm, zone, koS, plane, flight, wp, loot, lootChest, panel, chests, zones, barriers, boxCount: W.boxes.length, mode, phase, list, me, T, timeLeft, mapDef, D, uiOpen, adsK };
  }
  function debugMakeWeapon(id, rar) {
    return makeWeapon(id, rar);
  }
  function debugStep(n, dt) {
    for (let i = 0; i < n; i++) frame(dt);
  }

  // src/main.js
  var errBox = () => document.getElementById("err");
  function showErr(msg) {
    const e = errBox();
    e.style.display = "block";
    e.textContent = msg;
  }
  window.addEventListener("error", (ev) => showErr("Error: " + (ev.message || "unknown") + (ev.filename ? " (" + ev.filename.split("/").pop() + ":" + ev.lineno + ")" : "")));
  window.addEventListener("unhandledrejection", (ev) => showErr("Error: " + (ev.reason && ev.reason.message || ev.reason)));
  function boot() {
    if (typeof THREE === "undefined") {
      showErr("Could not load Three.js from the CDN. Check your internet connection (cdnjs.cloudflare.com must be reachable) and reload.");
      return;
    }
    const canvas2 = $("gl");
    try {
      initGame(canvas2);
    } catch (e) {
      showErr("WebGL could not start: " + e.message + ". Try a different browser or enable hardware acceleration.");
      return;
    }
    hud.init();
    let musicOn = false;
    initInput(canvas2, {
      canLock,
      onPause: () => pause(),
      onGesture: () => {
        init();
        if (S.autoFs) requestFs();
        if (!musicOn && getPhase() === "menu") {
          musicOn = true;
          startMusic("menu");
        }
      }
    });
    registerNet();
    setupHooks();
    initMenus();
    loadMap(S.map, false);
    show("main");
    document.addEventListener("fullscreenchange", () => setTimeout(resize, 150));
    document.addEventListener("webkitfullscreenchange", () => setTimeout(resize, 150));
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) visibilityHidden();
    });
    let last2 = performance.now();
    const loop = (ts) => {
      requestAnimationFrame(loop);
      const lim = S.fps, ms = ts - last2;
      if (lim > 0 && ms < 1e3 / lim - 2) return;
      last2 = ts;
      if (inp.pause) {
        inp.pause = false;
        if (isPaused()) resume();
        else pause();
      }
      frame(ms / 1e3);
    };
    requestAnimationFrame(loop);
    window.__zs = { game: game_exports, step: debugStep, state: debugState, inp, net, S };
  }
  var lob = { code: "", host: "", players: [], map: "desert", time: 300, phase: "lobby" };
  function defaultServer() {
    const h = location.hostname;
    if (location.protocol === "file:") return "ws://localhost:8080";
    if (!h || /claude|anthropic/i.test(h)) return "";
    return (location.protocol === "https:" ? "wss://" : "ws://") + location.host;
  }
  function normUrl(v) {
    v = (v || "").trim();
    if (!v) return "";
    if (/^https?:\/\//i.test(v)) v = v.replace(/^http/i, "ws");
    if (!/^wss?:\/\//i.test(v)) v = (/^(localhost|\d+\.\d+\.\d+\.\d+)/.test(v) ? "ws://" : "wss://") + v;
    return v;
  }
  async function ensureConn() {
    const raw = $("mpServer").value.trim();
    S.server = raw;
    save();
    const url = normUrl(raw);
    if (!url) {
      setMpStatus("Enter your server address first (see README).", "bad");
      return false;
    }
    if (location.protocol === "https:" && url.startsWith("ws://") && !/localhost|127\.0\.0\.1/.test(url)) {
      setMpStatus("This page is https, so the server must use wss:// (secure WebSocket).", "bad");
      return false;
    }
    setMpStatus("Connecting\u2026");
    try {
      if (!net.open || net.url !== url) await connect(url);
      setMpStatus("Connected", "ok");
      return true;
    } catch (e) {
      setMpStatus(e.message + ". Check the address and that the server is running.", "bad");
      return false;
    }
  }
  var amHost = () => lob.host === net.id;
  function renderLobby() {
    $("lobCode").textContent = lob.code;
    $("lobCount").textContent = `(${lob.players.length}/8)`;
    $("lobPlayers").innerHTML = lob.players.map((p) => `<li><span>${esc(p.name)}${p.id === net.id ? " (you)" : ""} <small style="color:var(--dim)">${esc(charOf(p.char).name)}</small></span>${p.id === lob.host ? "<i>HOST</i>" : ""}</li>`).join("");
    $("lobInfo").innerHTML = `${esc(MAP_INFO[lob.map].name)}<br>${Math.round(lob.time / 60)} minute match \xB7 free for all`;
    const host = amHost();
    $("lobHost").style.display = host ? "" : "none";
    $("lobStart").style.display = host ? "" : "none";
    $("lobWait").textContent = host ? "Share the room code. Start when everyone has joined." : "Waiting for the host to start the match\u2026";
    if ($("lobMapSeg")._paint) {
      $("lobMapSeg")._paint();
      $("lobTimeSeg")._paint();
    }
  }
  function setupNet() {
    on("joined", (m) => {
      net.id = m.id;
      lob = { code: m.code, host: m.host, players: m.players, map: m.map, time: m.time, phase: m.phase };
      if (!currentScreen() || currentScreen() === "mpmenu") {
        renderLobby();
        show("lobby");
      }
    });
    on("lobby", (m) => {
      lob.players = m.players;
      lob.host = m.host;
      lob.map = m.map;
      lob.time = m.time;
      lob.phase = m.phase;
      gameLobby(m);
      if (m.phase === "lobby" && getMode() === "menu" && net.open && lob.code) {
      }
      if (m.phase === "lobby" && getPhase() === "over") {
        toLobbyView(lob.map);
        show("lobby");
      }
      renderLobby();
    });
    on("start", (m) => {
      startMP(m);
    });
    on("err", (m) => {
      setMpStatus(m.msg, "bad");
      tip(m.msg);
    });
    on("close", () => {
      if (getMode() === "mp" || currentScreen() === "lobby") {
        tip("Disconnected from server");
        lob.code = "";
        toMenu();
      } else setMpStatus("Disconnected", "bad");
    });
  }
  function setupHooks() {
    setupNet();
    H2.defaultServer = defaultServer;
    H2.startSP = () => startSP();
    H2.onScreen = (id) => {
      if (id === "char") {
        setPreview(true);
        enterHeroScreen();
      } else setPreview(false);
    };
    H2.previewHero = (id) => previewHero(id);
    H2.previewDrag = (on2, dx) => previewDrag(on2, dx);
    H2.previewMap = (id) => previewMap(id);
    H2.resume = () => resume();
    H2.restart = () => restart();
    H2.toMenu = () => {
      lob.code = "";
      toMenu();
    };
    H2.paused = () => isPaused();
    H2.again = () => {
      if (getMode() === "mp") {
        if (amHost()) send("lobby", {});
        toLobbyView(lob.map);
        renderLobby();
        show("lobby");
      } else matchAgain();
    };
    H2.onSetting = (k) => {
      if (k === "quality") applyQuality();
      else if (k === "sfx" || k === "music") applyVolumes();
      else if (k === "btnScale" || k === "btnOpacity" || k === "touchMode") {
        applyLayout();
        refreshTouch();
      }
    };
    H2.onMpMenu = () => setMpStatus(net.open ? "Connected" : "Not connected", net.open ? "ok" : "");
    let editReturn = "settings";
    H2.editLayout = () => {
      editReturn = currentScreen() || "settings";
      show("edit");
      setEditMode(true, H2.editSelect);
      setTouchVisible(true);
      applyLayout();
    };
    H2.editDone = () => {
      refreshTouch();
      if (!isPaused() && getMode() === "menu") setTouchVisible(false);
      show("settings", false);
    };
    H2.mpCreate = async () => {
      if (!await ensureConn()) return;
      send("create", { name: S.name || "Player", map: S.mpMap, time: S.mpTime, char: S.char });
    };
    H2.mpJoin = async (code) => {
      if (code.length !== 4) {
        setMpStatus("Enter the 4-letter room code.", "bad");
        return;
      }
      if (!await ensureConn()) return;
      send("join", { code, name: S.name || "Player", char: S.char });
    };
    H2.mpLeave = () => {
      send("leave", {});
      close();
      lob.code = "";
      show("mpmenu", false);
      setMpStatus("Not connected");
    };
    H2.mpStart = () => send("start", {});
    setTimeout(() => {
      mkSeg($("lobMapSeg"), MAP_IDS.map((id) => [id, MAP_INFO[id].short]), () => lob.map, (v) => send("setup", { map: v, time: lob.time }));
      mkSeg($("lobTimeSeg"), [[180, "3 MIN"], [300, "5 MIN"], [600, "10 MIN"]], () => lob.time, (v) => send("setup", { map: lob.map, time: v }));
    }, 0);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
})();

</script>

